{
  "root": true,
  "plugins": [
    "project-structure",
    "import"
  ],
  "extends": [
    "next/core-web-vitals",
    "plugin:import/recommended",
    "plugin:import/typescript"
  ],
  "rules": {
    "import/order": [2, {
      "groups": ["builtin", "external", "internal", "parent", "sibling", "index", "object", "type"],
      "pathGroups": [
        { "pattern": "@/**", "group": "internal", "position": "before" },
        { "pattern": "@features/**", "group": "internal", "position": "before" },
        { "pattern": "@components/**", "group": "internal", "position": "before" },
        { "pattern": "@lib/**", "group": "internal", "position": "before" }
      ],
      "pathGroupsExcludedImportTypes": ["builtin"],
      "newlines-between": "always",
      "alphabetize": { "order": "asc", "caseInsensitive": true }
    }],
    "import/no-restricted-paths": [2, {
      "zones": [
        { "target": "src/features/**", "from": "src/app/**", "message": "Features should not import from the 'app' layer." },
        { "target": "src/components/**", "from": "src/features/**", "message": "Global components should not import from features." },
        { "target": "src/components/**", "from": "src/app/**", "message": "Global components should not import from the app layer." },
        { "target": "src/lib/**", "from": "src/features/**", "message": "Global lib should not import from features." },
        { "target": "src/lib/**", "from": "src/components/**", "message": "Global lib should not import from components." },
        { "target": "src/lib/**", "from": "src/app/**", "message": "Global lib should not import from the app layer." },
        { "target": "./src/**", "from": "./src/services", "message": "Global 'src/services/' is deprecated. Use 'src/lib/clients/' or feature-specific lib." },
        { "target": "./src/**", "from": "./src/utils", "message": "Global 'src/utils/' is deprecated. Use 'src/lib/utils/' or feature-specific lib." },
        { "target": "./src/**", "from": "./src/styles", "message": "Global 'src/styles/' is deprecated. Use 'src/globals.css'." }
      ]
    }],
    "no-restricted-imports": ["error", {
        "patterns": [
          { "group": ["**/src/services/**"], "message": "Global 'src/services/' is deprecated. Use 'src/lib/clients/' or feature-specific services." },
          { "group": ["**/src/utils/**", "!**/src/lib/utils/**"], "message": "Global 'src/utils/' is deprecated. Use 'src/lib/utils/' or feature-specific utils." },
          { "group": ["**/src/styles/**"], "message": "Global 'src/styles/' is deprecated. Use 'src/globals.css' or component-specific styles." }
        ]
      }
    ],
    "project-structure/independent-modules": [2, {
      "debugMode": false,
      "modules": [
        // --- Global Layers ---
        {
          "name": "global-lib-db-config",
          "pattern": "src/lib/db-config/**",
          "allowImportsFrom": ["*", "@/lib/shared-types/**"]
        },
        {
          "name": "global-lib-utils",
          "pattern": "src/lib/utils/**",
          "allowImportsFrom": ["@/lib/shared-types/**"]
        },
        {
          "name": "global-lib-clients",
          "pattern": "src/lib/clients/**",
          "allowImportsFrom": ["*", "@/lib/shared-types/**", "@/lib/constants/**"]
        },
        {
          "name": "global-lib-shared-types",
          "pattern": "src/lib/shared-types/**",
          "allowImportsFrom": ["zod"] // Permite Zod para definir schemas aqui
        },
        {
          "name": "global-lib-constants",
          "pattern": "src/lib/constants/**",
          "allowImportsFrom": []
        },
        {
          "name": "global-lib-root",
          "pattern": "src/lib/*",
          "allowImportsFrom": ["@/lib/utils/**", "@/lib/clients/**", "@/lib/shared-types/**", "@/lib/constants/**", "*"] // Permitir '*' para pacotes externos
        },
        {
          "name": "global-components-ui",
          "pattern": "src/components/ui/**",
          "allowImportsFrom": ["@/lib/utils/**", "@/lib/shared-types/**", "react", "lucide-react", "class-variance-authority", "@radix-ui/**", "cmdk", "embla-carousel-react", "react-day-picker", "react-dropzone", "vaul", "@/components/providers/**"] // Adicionado providers
        },
        {
          "name": "global-components-generic",
          "pattern": "src/components/*",
          "allowImportsFrom": ["@/components/ui/**", "@/lib/**", "react", "next/**", "lucide-react", "@/assets/**", "@/features/**/components/**", "@/features/**/types/**", "@/features/**/actions/**"] // Permitir de features components, types, actions
        },
        {
          "name": "global-providers", // Para src/components/providers
          "pattern": "src/components/providers/**",
          "allowImportsFrom": ["react", "next-themes", "react-dropzone", "*"]
        },
        // --- Feature Layers ---
        {
          "name": "feature-types",
          "pattern": "src/features/[a-z0-9-]+/types/**",
          "allowImportsFrom": ["zod", "drizzle-zod", "@/lib/shared-types/**", "@/lib/db-config/schema/**", "../db/**"]
        },
        {
          "name": "feature-db",
          "pattern": "src/features/[a-z0-9-]+/db/**",
          "allowImportsFrom": ["@/lib/db-config/**", "../types/**", "drizzle-orm", "@/lib/shared-types/**"]
        },
        {
          "name": "feature-lib",
          "pattern": "src/features/[a-z0-9-]+/lib/**",
          "allowImportsFrom": ["../types/**", "@/lib/**", "*"]
        },
        {
          "name": "feature-usecases",
          "pattern": "src/features/[a-z0-9-]+/usecases/**",
          "allowImportsFrom": ["../types/**", "../db/**", "../lib/**", "@/lib/**", "zod", "*"]
        },
        {
          "name": "feature-actions",
          "pattern": "src/features/[a-z0-9-]+/actions/**",
          "allowImportsFrom": ["../types/**", "../usecases/**", "../db/**", "../lib/**", "@/lib/**", "next/cache", "zod", "next/navigation", "*"]
        },
        {
          "name": "feature-components",
          "pattern": "src/features/[a-z0-9-]+/components/**",
          "allowImportsFrom": [
            "../types/**", "../actions/**", "../lib/**",
            "@/components/ui/**", "@/components/**",
            "@/lib/**",
            "react", "next/**", "lucide-react", "sonner", "react-hook-form", "@hookform/resolvers/zod", "date-fns", "use-debounce", "date-fns/locale", "*"
          ]
        },
        // --- App Layer ---
        {
          "name": "app-layer",
          "pattern": "src/app/**",
          "allowImportsFrom": [
            "@/features/[a-z0-9-]+/components/**",
            "@/features/[a-z0-9-]+/actions/**",
            "@/features/[a-z0-9-]+/types/**",
            "@/features/[a-z0-9-]+/schemas/**", // Mantido temporariamente se schemas não estiverem em types
            "@/features/[a-z0-9-]+/usecases/**", // Permitindo app importar usecases diretamente
            "@/components/**",
            "@/lib/**",
            "@/assets/**",
            "next/**", "react", "lucide-react", "@/globals.css", "zod", "date-fns", "use-debounce", "date-fns/locale"
          ]
        },
        // --- Root src files ---
        {
            "name": "src-root",
            "pattern": "src/*", // Ex: src/globals.css, src/constant.tsx
            "allowImportsFrom": ["*", "./styles/**"] // Permitir globals.css importar de styles (se houver)
        },
        {
            "name": "src-global-types", // Para src/types/ se existir
            "pattern": "src/types/**",
            "allowImportsFrom": ["*"]
        }
      ]
    }]
  },
  "settings": {
    "import/resolver": {
      "typescript": {
        "alwaysTryTypes": true,
        "project": "./tsconfig.json"
      }
    }
  },
  "overrides": []
}
